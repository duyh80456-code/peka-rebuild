# Copy this file to .env (at the workspace root) and fill in.
# All paths are absolute. Use ${HOME} or similar if you need expansion.

# Weights & Biases (required for experiment tracking; pass --with_logger csv to disable)
WANDB_API_KEY=
WANDB_ENTITY=

# HuggingFace (required to download HEST1K and H-optimus-0 / UNI weights)
HF_TOKEN=

# HEST1K filtered storage location.
# With breast-only filter (default for this repo), expect ~30-100 GB (vs. ~1 TB for full).
# Default: <workspace>/DATA/HEST1K
HEST1K_STORAGE_PATH=

# Optional: override workspace root (default: derived from src/peka/paths.py)
# WORKSPACE=/path/to/PEKA
